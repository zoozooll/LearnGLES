<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Right Face (Blue - Z axis) -->
    <path
        android:pathData="M54,25 L84,40 L84,70 L54,85 Z"
        android:fillAlpha="0.8">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54" android:startY="25"
                android:endX="84" android:endY="70"
                android:type="linear">
                <item android:offset="0" android:color="#FF007FFF"/> <!-- Azure -->
                <item android:offset="1" android:color="#FF003366"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left Face (Green - Y axis) -->
    <path
        android:pathData="M54,25 L24,40 L24,70 L54,85 Z"
        android:fillAlpha="0.9">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54" android:startY="25"
                android:endX="24" android:endY="70"
                android:type="linear">
                <item android:offset="0" android:color="#FF00FF7F"/> <!-- Spring Green -->
                <item android:offset="1" android:color="#FF006633"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Face (Red - X axis) -->
    <path
        android:pathData="M54,25 L84,40 L54,55 L24,40 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54" android:startY="25"
                android:endX="54" android:endY="55"
                android:type="linear">
                <item android:offset="0" android:color="#FFFF4D4D"/> <!-- Soft Red -->
                <item android:offset="1" android:color="#FF990000"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Highlight/Wireframe line -->
    <path
        android:pathData="M54,25 L54,55 M54,55 L24,40 M54,55 L84,40"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1"
        android:strokeAlpha="0.3"/>
</vector>